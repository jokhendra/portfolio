## Public site URL used for metadata, robots, sitemap and the OG image
NEXT_PUBLIC_SITE_URL=http://localhost:3000

## Cal.com embed link (optional). The schedule section is hidden when unset.
## Example: yourhandle/30min
# NEXT_PUBLIC_CAL_LINK=

## MongoDB connection string (optional).
## When unset, the contact form runs in demo mode without persistence.
# MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/portfolio

## Portfolio agent (optional).
## Without a key the agent still routes, retrieves and answers extractively
## from the site corpus, and labels itself as retrieval-only in the UI.
## Provider order: Google → Groq → OpenAI.
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.5-flash-lite
# GROQ_API_KEY=
# OPENAI_API_KEY=
## Optional override used by Groq/OpenAI (Google prefers GOOGLE_MODEL)
# AGENT_MODEL=
